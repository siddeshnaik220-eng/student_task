{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Flask Web App",
      "type": "debugpy",
      "request": "launch",
      "module": "app.web",
      "cwd": "${workspaceFolder}",
      "env": {
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1"
      },
      "jinja": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Run CLI App",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
